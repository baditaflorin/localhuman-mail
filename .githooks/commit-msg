#!/usr/bin/env bash
set -euo pipefail

message_file="$1"
first_line="$(head -n 1 "$message_file")"

if [[ ! "$first_line" =~ ^(feat|fix|docs|chore|refactor|test|ops|data)(\([a-zA-Z0-9_-]+\))?:\ .+ ]]; then
  echo "Commit message must use Conventional Commits."
  echo "Example: feat: add mailbox search"
  exit 1
fi

